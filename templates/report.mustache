{{!
    @template mod_videonotes/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videonotes-report">
    <h2>{{title}}</h2>
    <p>{{activityname}}</p>
    {{#hasrows}}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{#str}}student, videonotes{{/str}}</th>
                    <th>{{#str}}timestamp, videonotes{{/str}}</th>
                    <th>{{#str}}category, videonotes{{/str}}</th>
                    <th>{{#str}}note, videonotes{{/str}}</th>
                </tr>
                </thead>
                <tbody>
                {{#rows}}
                    <tr>
                        <td>{{fullname}}<br><small>{{email}}</small></td>
                        <td>{{timestring}}</td>
                        <td>{{categorylabel}}</td>
                        <td>{{note}}</td>
                    </tr>{{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}
    {{^hasrows}}
        <div class="alert alert-info">{{#str}}nosharednotes, videonotes{{/str}}</div>{{/hasrows}}
</div>
